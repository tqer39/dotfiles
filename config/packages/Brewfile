# ------------------------------------------------------------------------------
# Brewfile - Homebrew packages for macOS and Linux
# ------------------------------------------------------------------------------
# Usage: brew bundle --file=Brewfile
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# CLI Tools
# ------------------------------------------------------------------------------

# Shell and prompt
brew "zsh"
brew "sheldon"    # zsh plugin manager
brew "starship"

# Git
brew "git"
brew "gh"
brew "lazygit"      # terminal UI for git

# Modern CLI replacements
brew "eza"          # ls replacement
brew "bat"          # cat replacement
brew "fzf"          # fuzzy finder
brew "ripgrep"      # grep replacement
brew "zoxide"       # cd replacement
brew "tmux"         # terminal multiplexer
brew "zellij"       # terminal multiplexer
brew "herdr"        # agent multiplexer (AI coding agents)

# Development tools
brew "direnv"
brew "shellcheck"
brew "pre-commit"
brew "just"          # task runner
brew "lefthook"      # git hooks manager
brew "rtk"           # CLI proxy for LLM token optimization

# Cloud credentials
brew "aws-vault"
tap "jacobbednarz/tap"
brew "jacobbednarz/tap/cf-vault"

# Runtime managers
brew "mise"       # Node.js, etc.
brew "uv"         # Python

# Utilities
brew "curl"
brew "wget"
brew "jq"
brew "tailscale"
brew "tree"
brew "gnupg"
brew "xsel" if OS.linux?  # clipboard support for Linux

# ------------------------------------------------------------------------------
# Cross-platform casks (macOS / Linux 両対応)
# ------------------------------------------------------------------------------
# claude-code は depends_on が無い binary-only cask のため Linuxbrew でも入る。
# mise の npm 経由だと Linux で postinstall が走らずバイナリが壊れるため cask を使う。
cask "claude-code"  # Claude Code CLI

# ------------------------------------------------------------------------------
# macOS Only - Casks
# ------------------------------------------------------------------------------
if OS.mac?
  # Fonts
  cask "font-hackgen-nerd"

  # Terminal
  cask "ghostty"
  cask "wezterm"

  # Development
  cask "visual-studio-code"

  # AI
  cask "claude"  # Claude Desktop (includes Cowork)

  # Productivity
  cask "1password"
  cask "linear-linear"  # Project management
  cask "raycast"

  # Keyboard & Window Management
  cask "karabiner-elements"
  cask "hammerspoon"

  # Media
  cask "vlc"

end

# ------------------------------------------------------------------------------
# Personal packages (skipped with --work flag)
# ------------------------------------------------------------------------------
# NOTE: Homebrew は Brewfile を評価する前に HOMEBREW_ 接頭辞のない環境変数を
# 除去するため、ENV['WORK_MODE'] は常に nil になる。work/personal の判定には
# 必ず HOMEBREW_WORK_MODE を使うこと (scripts/installers/homebrew.sh が
# WORK_MODE から引き渡す)。
if OS.mac? && ENV['HOMEBREW_WORK_MODE'] != 'true'
  cask "orbstack"  # Container management (Docker/Kubernetes)
  cask "spotify"
  cask "discord"
end

# ------------------------------------------------------------------------------
# Work packages (installed only with --work flag)
# ------------------------------------------------------------------------------
# cursor-cli / devin-cli は Homebrew 上では macOS 限定の cask のため、Linuxbrew
# ではインストールできない (cask 自体が非対応)。
if OS.mac? && ENV['HOMEBREW_WORK_MODE'] == 'true'
  cask "cursor"      # AI code editor
  cask "cursor-cli"  # Cursor CLI (cursor-agent)
  cask "devin-cli"   # Devin CLI (devin)

  # CLI / lint / release tools
  brew "actionlint"     # GitHub Actions workflow linter
  brew "biome"          # JS/TS formatter & linter
  brew "golangci-lint"  # Go linters aggregator
  brew "goreleaser"     # Go release automation
  brew "osv-scanner"    # vulnerability scanner
  brew "pinact"         # pin GitHub Actions versions
  brew "prek"           # pre-commit compatible runner
  brew "yamllint"
  brew "shfmt"          # shell formatter
  brew "ruff"           # Python linter & formatter
  brew "yazi"           # terminal file manager
  brew "yq"             # YAML processor
  brew "fd"             # find replacement
  brew "autossh"        # auto-reconnecting ssh
  brew "docker-compose"
  brew "mas"            # Mac App Store CLI

  # Browsers / communication
  cask "google-chrome"
  cask "brave-browser"
  cask "slack"
  cask "deepl"

  # Design / docs
  cask "figma"
  cask "drawio"
  cask "cleanshot"           # screenshot tool
  cask "adobe-acrobat-pro"
  cask "google-drive"
  cask "google-japanese-ime"

  # AI tools
  cask "chatgpt"
  cask "comet"        # Perplexity browser
  cask "coderabbit"   # AI code review CLI

  # Dev / infra clients
  cask "postman"
  cask "podman-desktop"
  cask "rancher"                  # Rancher Desktop (container runtime)
  cask "mysqlworkbench"
  cask "nosql-workbench"          # DynamoDB NoSQL Workbench
  cask "session-manager-plugin"   # AWS SSM Session Manager plugin
  cask "zed"
  cask "warp"
  cask "alt-tab"      # Windows-style window switcher

  # Mac App Store
  mas "Kindle", id: 302584613
  mas "Okta Verify", id: 490179405
  mas "RunCat", id: 1429033973
end

